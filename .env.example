# Copy to .env (never commit it) and fill in your key.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Optional overrides — defaults are the hosted NVIDIA API.
# NEMOTRON_MODEL=<model id from build.nvidia.com>
# COSMOS_MODEL=nvidia/cosmos-reason2-8b
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# COSMOS_BASE_URL=https://integrate.api.nvidia.com/v1
