# Copy to .env (never commit it) and fill in your key.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Nemotron on Nebius Token Factory (OpenAI-compatible). Take the exact model id from the Token Factory catalogue.
# NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEMOTRON_API_KEY=<your Nebius Token Factory key>
# NEMOTRON_MODEL=<a Nemotron model id from the Token Factory catalogue>

# Optional overrides — defaults are the hosted NVIDIA API.
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # default; any model id from build.nvidia.com
# COSMOS_MODEL=nvidia/cosmos3-nano-reasoner               # default; served by the local NIM (./run.sh --cosmos)
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# COSMOS_BASE_URL=http://localhost:8001/v1                # default: the local Cosmos NIM

# Planner (all optional): PHYSYK_PLANNER=stepwise|upfront, NEMOTRON_STEP_THINKING=off|on, NEMOTRON_THINKING=off|on

# Ports / timeouts (optional)
# PHYSYK_GUI_PORT=7860   PHYSYK_SIM_PORT=8100
# NEMOTRON_TIMEOUT_S=90  COSMOS_TIMEOUT_S=6  COSMOS_VERIFY_TIMEOUT_S=6  COSMOS_MAX_TOKENS=512
