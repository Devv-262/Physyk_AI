<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- Franka Emika Panda Robot Arm + Hand URDF for Isaac Sim / LIBERO Benchmark          -->
<!-- =================================================================================== -->
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="panda_link0">
    <visual>
      <geometry>
        <mesh filename="meshes/visual/link0.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/collision/link0.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0410 0.0001 0.0499"/>
      <mass value="0.6297"/>
      <inertia ixx="0.00315" ixy="8.29e-07" ixz="0.00015" iyy="0.00388" iyz="8.23e-06" izz="0.00428"/>
    </inertial>
  </link>

